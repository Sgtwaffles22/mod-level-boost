[worldserver]

########################################
# Level Boost
########################################
#
#    LevelBoost.Enable
#        Description: Toggles the Level Boost feature. When enabled, players can receive an automatic boost to the configured level at their race's starting quest giver.
#        Default:     1 - Enabled
#                     0 - Disabled
#

LevelBoost.Enable = 1

# LevelBoost.OneTimeOnly
# Prevents a character from claiming the boost more than once. Requires the character SQL table.
# Default: 1
LevelBoost.OneTimeOnly = 1

#
#    LevelBoost.Level
#        Description: Target level granted by the boost. Set this between 1 and MaxPlayerLevel.
#        Default:     15
#

LevelBoost.Level = 15

#
#    LevelBoost.Gold
#        Description: Whole gold granted when the boost is applied (1 gold = 10,000 copper). Set to 0 for none; the grant is capped by the core's money limit.
#        Default:     100 (100 gold)
#

LevelBoost.Gold = 100

#    Bags.Enable
#        Description: Gives the boosted character starter bags in empty bag slots.
#        Default:     1 - Enabled
#                     0 - Disabled
#

Bags.Enable = 1

#    Bags.Item
#        Description: item_template entry for the normal bag to grant. Default 4240 is an 8-slot Woolen Bag.
#        Default:     4240
#

Bags.Item = 4240

#    Bags.Count
#        Description: Number of bags to grant. The value is clamped to the four character bag slots.
#        Default:     4
#

Bags.Count = 4

#
#    ClassQuests.Enable
#        Description: Marks all eligible non-repeatable class quests through the target level as rewarded, regardless of reward type.
#                     Learnable quest spells are still applied. Quest XP and money are not granted.
#                     Control item rewards separately with ClassQuests.GrantItems.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ClassQuests.Enable = 1

#
#    ClassQuests.GrantItems
#        Description: Grants valid item rewards from eligible class quests. Requires ClassQuests.Enable = 1.
#                     Quest completion still grants learnable quest spells when this is disabled.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ClassQuests.GrantItems = 1

#
#    ClassItems.Enable
#        Description: Grants additional class-specific utility items during a boost (currently Shaman totems).
#        Default:     1 - Enabled
#                     0 - Disabled
#

ClassItems.Enable = 1

#
#    Gear.Random.Enable
#        Description: Uses the original random gear templates instead of the ranked level-15 BiS templates.
#                     The original template seed ranks eligible items by quality and item level. Restart or reload the server config after changing it.
#        Default:     0 - Ranked BiS gear
#                     1 - Random gear templates
#

Gear.Random.Enable = 0

#
#    LearnSpells.Enable
#        Description: Learns class spells from the mod_boost_class_spells table that match the boosted character's class and level.
#                     Apply class_spells_table.sql to populate this table.
#        Default:     1 - Enabled
#                     0 - Disabled
#

LearnSpells.Enable = 1

#
#    LearnProficiencies.Enable
#        Description: Grants the character class-specific weapon and armor proficiencies when they receive the level boost.
#        Default:     1 - Enabled
#                     0 - Disabled
#

LearnProficiencies.Enable = 1

#
#    LearnTalents.Enable
#        Description: Automatically assigns talent points to the character in a pre-determined spec or build suitable for their class when boosted.
#        Default:     1 - Enabled
#                     0 - Disabled
#

LearnTalents.Enable = 1

#
#    LearnGlyphs.Enable
#        Description: Equips the character with glyphs that enhance their abilities, chosen based on their class and spec when the boost is applied.
#        Default:     1 - Enabled
#                     0 - Disabled
#

LearnGlyphs.Enable = 1

#
#    DualSpec.Enable
#        Description: Gives the character the ability to use Dual Specialization, allowing them to switch between two different talent specs.
#        Default:     0 - Disabled
#                     1 - Enabled
#

DualSpec.Enable = 0

#
#    DestroyGear.Enable
#        Description: Removes starting gear from the character when the level boost is applied to make room for the new gear set.
#        Default:     1 - Enabled
#                     0 - Disabled
#

DestroyGear.Enable = 1
